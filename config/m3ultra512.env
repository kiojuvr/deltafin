K3_MODEL_DIR=/Volumes/USB-SSD-RAID-0/models/moonshotai/Kimi-K3
K3_DIRECT_SHARDS_SIDECAR=bench-results/k3-direct-shards-index.json.gz
K3_PLATFORM=m3-ultra-512gb
K3_DEV=mps
K3_MOE=metal
K3_ALLOW_HTTP=0
K3_ALLOW_MODEL_CONVERSION=0
K3_EXPERT_SOURCE=direct-shards
K3_RESIDENT_SOURCE=direct-shards
K3_RESIDENT_BANK=1
# The M6 source-dtype mode is opt-in because it trades ~0.38 s/token of
# materialization for 114 GB more page-cache headroom. It requires pin-layers 0.
K3_RESIDENT_BANK_DTYPE=runtime
# M7 fixed runtime-dtype scratch is only meaningful with source bank + pin 0.
# Serial uses one slot; the measured two-slot worker overlap did not win.
K3_RESIDENT_SCRATCH=0
K3_RESIDENT_SCRATCH_OVERLAP=0
K3_RESIDENT_SCRATCH_SLOTS=1
K3_PREAD_NOCACHE=0
K3_DIRECT_SLAB=1
# Experimental M4/M5 settings are documented under docs/. Keep overlap off
# until a controlled cold A/B demonstrates an end-to-end win.
K3_DIRECT_OVERLAP=0
K3_SPINE=bf16
K3_DTYPE=fp32
K3_APPROX=0
K3_INT8_LM_HEAD=0
K3_INT8_KDA_QKV=0
K3_SPINE_PACK=0
K3_SPEC_DEPTH=1
PYTORCH_MPS_HIGH_WATERMARK_RATIO=1.0
PYTORCH_MPS_LOW_WATERMARK_RATIO=0.9
K3_TEMPLATES=0
K3_PIN_LAYERS=93
K3_PRELOAD=0
K3_EXPERT_PREFETCH=0
K3_PREFETCH=0
K3_PILOT=0
K3_MOE_GROUP_SIZE=0
K3_PROFILE=1
K3_TRACE=off
