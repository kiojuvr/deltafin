K3_MODEL_DIR=/Volumes/USB-SSD-RAID-0/models/moonshotai/Kimi-K3
K3_DIRECT_SHARDS_SIDECAR=bench-results/k3-direct-shards-index.json.gz
K3_PLATFORM=m3-ultra-512gb
K3_DEV=mps
K3_MOE=metal
K3_ALLOW_HTTP=0
K3_ALLOW_MODEL_CONVERSION=0
K3_EXPERT_SOURCE=direct-shards
K3_RESIDENT_SOURCE=direct-shards
K3_RESIDENT_BANK=1
# M8 selected the 114.4 GB checkpoint-native resident bank plus one reusable
# 4.68 GB FP32 layer arena. It recovered 109.7 GB for the macOS page cache and
# halved measured 16-token decode time without changing logits or routes.
K3_RESIDENT_BANK_DTYPE=source
K3_RESIDENT_SCRATCH=1
K3_RESIDENT_SCRATCH_OVERLAP=0
K3_RESIDENT_SCRATCH_SLOTS=1
K3_PREAD_NOCACHE=0
K3_DIRECT_SLAB=1
K3_DIRECT_PREFILL_SLAB_EXPERTS=896
K3_METAL_POSITION_BATCH=1
# M12 keeps the official monolithic prompt shape while caching only the fixed
# 74-token prefix's routed-MoE inputs/outputs. Entries are keyed by the complete
# prompt length, validated bitwise on every replay, and bounded to ~390 MB here.
K3_PREFIX_ACTIVATION=1
K3_PREFIX_ACTIVATION_ENTRIES=2
# M14 records only request shape/LRU metadata: no prompt text, token IDs, or
# request hashes. Use the offline capacity sweep before changing entry count.
K3_SERVER_SHAPE_TRACE_JSONL=bench-results/m14-server-shapes.jsonl
K3_SERVER_SHAPE_TRACE_MAX_BYTES=16777216
# Experimental M4/M5 settings are documented under docs/. Keep overlap off
# until a controlled cold A/B demonstrates an end-to-end win.
K3_DIRECT_OVERLAP=0
K3_SPINE=bf16
K3_DTYPE=fp32
K3_APPROX=0
K3_INT8_LM_HEAD=0
K3_INT8_KDA_QKV=0
K3_SPINE_PACK=0
K3_SPEC_DEPTH=1
PYTORCH_MPS_HIGH_WATERMARK_RATIO=1.0
PYTORCH_MPS_LOW_WATERMARK_RATIO=0.9
K3_TEMPLATES=0
K3_PIN_LAYERS=0
K3_PRELOAD=0
K3_EXPERT_PREFETCH=0
K3_PREFETCH=0
K3_PILOT=0
K3_MOE_GROUP_SIZE=0
K3_PROFILE=1
K3_TRACE=off
